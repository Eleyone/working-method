# workflow.config du dépôt commun lui-même : il se sert de son propre outillage pour ses PR.
# Format et champs : workflow.config.example, procedures/workflow-config.md.

[workflow]
	schema = 6

[forge]
	repo = Eleyone/working-method
	base = main
	# une seule branche : pas de branche de publication distincte
	release-branch = none
	branch-prefixes = feat fix chore docs
	env-file = .env

[sprint]
	# le suivi de sprint vit dans les projets, pas ici
	convention = none
	status-file = none
	stories-dir = none
	spec-source = none
	# schéma 4 : sans suivi, aucune liste
	non-story-files = none

[review]
	# aucune exception : toute PR de ce dépôt est relue
	exempt-paths = none
	# schéma 6 : sans exception documentaire, les fichiers qui dirigent les agents n'ont rien à lever
	agent-paths = none
	report = pr-comment
	# fournisseur de l'auteur → relecteur d'un autre fournisseur (procedures/llm-review.md)
	reviewers = claude=gemini-3.1-pro-high gemini=claude-opus-5-5-high gpt=claude-opus-5-5-high
	timeout = 900
	project-layer = review/self-layer.md
	private-paths = .env .pr-body.md
	range-exclude = none

[guard]
	# le contrôle « aucun secret » de ce dépôt public tourne dans sa CI (ci/check-secrets.sh)
	command = none
	patterns-file = none

[ci]
	workflow = .gitea/workflows/checks.yml
	status-context = checks
	# schéma 5 : le verrou d'avant — les statuts de status-context seuls, une CI en cours bloque tout de suite
	statuses = context
	wait = 0
	bootstrap = false

[checks]
	command = ci/checks-job.sh
	dir = none

[tests]
	protected-outputs = none

[bmad]
	version = 6.12.0
	modules = core bmm
	# bin/install ne tourne pas sur ce dépôt : ces valeurs ne servent qu'à le rendre lisible au schéma 6
	project-name = working-method
	document-output-language = Français
	output-folder = _bmad-output

[agents]
	skill-dirs = .claude/skills .agents/skills
