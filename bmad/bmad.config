# La version de BMAD que porte le dépôt commun, et la seule que ses projets utilisent.
# Format git config, lu par lib/bmad.sh (bmad_declared_load) : un champ absent, inconnu ou en double
# fait refuser le fichier entier, sans valeur par défaut. Procédure : procedures/bmad.md
#
# ⛔ Modifier ce fichier n'installe rien : relancer bmad/update.sh, qui rejoue l'installeur BMAD et
# réécrit bmad/method/. La CI vérifie que bmad/method/ est exactement ce que l'installeur produit.

[bmad]
	# version du paquet npm bmad-method ; les projets la déclarent dans leur workflow.config (bmad.version)
	version = 6.12.0
	# l'union des modules (décision d'Arnaud du 04/10/2026) : six, sans wds ni render ;
	# chaque projet active son sous-ensemble dans workflow.config (bmad.modules)
	modules = core bmm bmb cis bmad-loop tea
	# les skills de compatibilité v6 (bmad-create-story, bmad-dev-story, bmad-sprint-status…)
	shims = true

[pin]
	# une version exacte par module externe : le canal « stable » de l'installeur dériverait avec le temps
	bmb = v2.2.2
	cis = v0.3.2
	bmad-loop = v0.11.1
	tea = v1.27.2
