#!/bin/sh
# Vérifie le prérequis bash de l'outillage commun : 0 si bash 4.3 ou plus est dans le PATH, 2 sinon,
# avec un message. Écrit en POSIX sh : c'est le premier pas de la CI et de bin/install, avant tout bash.
# Procédure : procedures/runner-bash.md
common=$(cd "$(dirname "$0")/.." && pwd) || exit 2
# shellcheck source=../lib/require-bash.sh
. "$common/lib/require-bash.sh"
require_bash || exit 2
printf 'check-bash : %s\n' "$(bash -c 'printf "bash %s" "$BASH_VERSION"')"
