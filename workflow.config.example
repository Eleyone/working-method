# workflow.config — ce qui est propre à un projet qui consomme le dépôt commun. Schéma 7.
#
# À la racine du projet, versionné. Format de git config, lu par
# « git config -f workflow.config --no-includes --null --list ».
#
# ⛔ Tous les champs sont obligatoires, et aucun n'a de valeur par défaut : un champ absent, inconnu,
# écrit deux fois, vide ou mal typé fait refuser le fichier entier, et l'outil sort en code 2.
# « none » désactive un champ marqué « désactivable » ; l'outil qui le lit le dit dans sa sortie.
#
# Pièges de la syntaxe de git config :
#   - un nom de section ou de clé ne contient pas « _ » (erreur de syntaxe) ; il s'écrit en
#     minuscules avec des tirets ;
#   - « \ » hors guillemets est une erreur de syntaxe : une expression régulière s'écrit sans
#     antislash, avec une classe de caractères ([.]md$ plutôt que \.md$) ;
#   - « # » et « ; » ouvrent un commentaire : une valeur qui en contient se met entre guillemets ;
#   - pas de « [include] » : il est refusé comme une section inconnue.
#
# Description de chaque champ : procedures/workflow-config.md du dépôt commun.

[workflow]
	# version du schéma : 3 à 7 ; le 4 ajoute sprint.non-story-files, qu'exige la convention keyed ;
	# le 5 ajoute ci.statuses et ci.wait, qu'exige verify-and-merge-pr ; le 6 ajoute review.agent-paths, sans
	# migration imposée (un fichier au schéma 5 reste valide) ; le 7 ajoute la section [protection], sans
	# migration imposée non plus (seul gitea/check-branch-protection.sh l'exige). Un fichier au schéma 1 ou 2
	# est refusé avec ce qu'il faut changer
	schema = 7

[forge]
	# dépôt sur la forge, « propriétaire/nom » ; le dépôt distant origin doit être celui-là
	repo = Proprietaire/projet
	# branche d'intégration, base de toutes les PR
	base = dev
	# branche de publication ; aucune PR n'y est ouverte ni fusionnée par l'outillage (désactivable)
	release-branch = main
	# préfixes de branche admis vers la base, sans « / »
	branch-prefixes = feat fix chore docs
	# fichier des variables GITEA_URL, GITEA_USER, GITEA_TOKEN, ignoré par git
	env-file = .env

[sprint]
	# convention du suivi : numbered (clés « n-m-titre »), keyed (clés kebab-case et bloc aliases:,
	# schéma 4), none
	convention = numbered
	# suivi de sprint (désactivable avec convention = none)
	status-file = _bmad-output/implementation-artifacts/sprint-status.yaml
	# dossier des fichiers de story (désactivable avec convention = none)
	stories-dir = _bmad-output/implementation-artifacts
	# texte des stories pour la revue de spec, en-têtes « ### Story n.m : » (désactivable)
	spec-source = _bmad-output/planning-artifacts/epics.md
	# keyed seulement (schéma 4) : noms des fichiers .md du dossier des stories qui ne sont pas des stories,
	# motifs à jokers « * » et « ? », sans « .md » (par exemple « deferred-work spec-* ») ; none : tout
	# fichier .md est une story. Vaut none dans toute autre convention
	non-story-files = none

[review]
	# expression régulière étendue : une PR dont CHAQUE fichier correspond est dispensée de revue
	# (désactivable)
	exempt-paths = ^_bmad-output/
	# schéma 6 : expression régulière étendue des fichiers qui dirigent les agents ; une PR exemptée qui en
	# touche un seul perd l'exception, et la revue est exigée pour toute la PR (désactivable). Un projet dont
	# les .md sont exemptés écrit par exemple, entre guillemets :
	#   "(^|/)(AGENTS|CLAUDE)[.]md$|^[.]claude/rules/|^docs/procedures/|^docs/review/"
	# Ici, aucun fichier qui dirige les agents n'est sous _bmad-output/ : none
	agent-paths = none
	# où va le rapport de revue : pr-comment, un commentaire de la PR (seule valeur ; « file » est retiré)
	report = pr-comment
	# table « fournisseur de l'auteur → relecteur » : une entrée « auteur=modèle » par fournisseur d'auteur
	# (claude, gemini, gpt…), le modèle pris dans « agy models » et d'un AUTRE fournisseur (premier segment
	# de son nom) ; un auteur sans entrée fait sortir la revue en 2, sans relecteur par défaut
	reviewers = claude=gemini-3.1-pro-high gemini=claude-opus-5-5-high gpt=claude-opus-5-5-high
	# délai maximal de la relecture, en secondes
	timeout = 900
	# fragment de consigne propre au projet : description, contexte, méthode de revue, contrôles
	project-layer = docs/review/project-layer.md
	# chemins qui ne doivent jamais se trouver dans la copie envoyée au relecteur
	private-paths = .env .pr-body.md
	# chemins écartés du diff d'une revue de plage (désactivable)
	range-exclude = _bmad-output

[guard]
	# garde-fou public/privé, appelé « <commande> history <plage> » (désactivable)
	command = none
	# liste des motifs privés du garde-fou (désactivable ; none exige command = none)
	patterns-file = none

[ci]
	# workflow de la CI qui fait foi, cherché sur la base (désactivable)
	workflow = .gitea/workflows/checks.yml
	# nom du workflow tel que la forge préfixe ses contextes de statut (désactivable avec workflow)
	status-context = checks
	# statuts jugés sur la tête (schéma 5, désactivable avec workflow) : context, ceux de status-context
	# seuls ; all, tous les statuts de la tête, et ceux de status-context doivent y être
	statuses = context
	# attente, en secondes, d'une CI en cours avant de bloquer (schéma 5, désactivable avec workflow) :
	# 0 bloque tout de suite ; une CI sans aucun statut n'est jamais attendue
	wait = 0
	# règle d'amorçage : true admet une CI absente tant que le workflow manque à la base
	bootstrap = false

[checks]
	# point d'entrée unique des contrôles, lancé à la racine (désactivable)
	command = none
	# dossier des contrôles découverts par checks/run-checks.sh (désactivable)
	dir = none

[tests]
	# sorties du projet que la suite de tests ne doit jamais toucher (désactivable)
	protected-outputs = none

[bmad]
	# version de BMAD déclarée par le projet : celle du sous-module (bmad/bmad.config), sinon bin/install rend 1
	version = 6.12.0
	# modules activés, parmi l'union du sous-module (core bmm bmb cis bmad-loop tea) ; core est requis
	modules = core bmm
	# valeurs de la configuration BMAD que bin/install génère (procedures/bmad.md)
	project-name = projet-exemple
	document-output-language = Français
	output-folder = _bmad-output

# Surcharges, OPTIONNELLES, des valeurs d'un module activé (procedures/workflow-config.md,
# « Surcharges des modules BMAD ») : sans elles, la configuration générée garde les valeurs du modèle
# du sous-module. Clés avec des tirets ; une clé inconnue du modèle est refusée (code 2). Exemple pour
# tea, s'il était activé dans bmad.modules :
# [module "tea"]
# 	test-artifacts = {project-root}/_bmad-output/test-artifacts
# 	test-framework = playwright

[agents]
	# dossiers où bin/install relie les skills du dépôt commun
	skill-dirs = .claude/skills .agents/skills

[protection]
	# schéma 7 : les valeurs du projet de la règle commune de protection des branches, que relit
	# gitea/check-branch-protection.sh (procedures/gitea-branches.md, « La règle commune »)
	# comptes admis à pousser directement sur forge.base, séparés par une espace (désactivable : aucun push)
	base-push = none
	# comptes admis à pousser en force sur forge.base, chacun aussi dans base-push (désactivable)
	base-force-push = none
	# comptes admis à pousser sur forge.release-branch, par exemple le compte d'une CI de publication
	# (désactivable ; none obligatoire sans branche de publication). Le push forcé y est toujours fermé
	release-push = none
	# comptes admis à fusionner une PR sur les deux branches (non désactivable)
	merge = Proprietaire
	# motifs des contextes de statut exigés par la forge, séparés par une virgule (désactivable)
	status-contexts = checks / checks*
	# une PR en retard sur sa base doit être mise à jour avant sa fusion : true ou false
	block-outdated = false
	# style de la publication, seul ouvert à côté du squash : merge ou fast-forward-only (désactivable ;
	# none obligatoire sans branche de publication)
	release-merge-style = merge
