# Projet fixture du test de réinstallation de BMAD (ci/bmad-reinstall.sh) : il porte les couches
# projet — ce fichier, _bmad/config.user.toml, _bmad/custom/ et _bmad-output/ — qu'une réinstallation
# ne doit jamais modifier. Il n'active qu'une partie des modules (AC 8 de la story 1).
[workflow]
	schema = 2
[forge]
	repo = Proprietaire/projet-fixture
	base = dev
	release-branch = main
	branch-prefixes = feat fix chore docs
	env-file = .env
[sprint]
	convention = keyed
	status-file = _bmad-output/implementation-artifacts/sprint-status.yaml
	stories-dir = _bmad-output/implementation-artifacts
	spec-source = none
[review]
	exempt-paths = [.]md$
	report = pr-comment
	reviewer-for-claude = gemini-3.1-pro-high
	reviewer-for-gemini = claude-opus-4-6-thinking
	timeout = 900
	project-layer = docs/review/project-layer.md
	private-paths = .env
	range-exclude = none
[guard]
	command = none
	patterns-file = none
[ci]
	workflow = none
	status-context = none
	bootstrap = false
[checks]
	command = none
	dir = none
[tests]
	protected-outputs = none
[bmad]
	version = 6.12.0
	modules = core bmm cis tea
	project-name = projet-fixture
	document-output-language = Français
	output-folder = _bmad-output
[agents]
	skill-dirs = .claude/skills .agents/skills
